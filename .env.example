# 复制为 .env；真实密钥只放环境变量，不要写入 accounts.json。
TRACKER_ACCOUNTS_FILE=config/accounts.json
POSITION_SCAN_INTERVAL_MS=300000
BINANCE_RECV_WINDOW=5000
BINANCE_SIGNED_REQUEST_RETRIES=2
FETCH_TIMEOUT_MS=15000

WEBHOOK_ENABLED=true
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_SIGNATURE_HEADER=X-Signature-256
WEBHOOK_SIGNATURE_TEMPLATE=sha256=<hex>
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_MS=1000

# config/accounts.json 中通过 apiKeyEnv/apiSecretEnv 引用这些变量。
BINANCE_STRATEGY_A_API_KEY=
BINANCE_STRATEGY_A_API_SECRET=
BINANCE_STRATEGY_B_API_KEY=
BINANCE_STRATEGY_B_API_SECRET=
